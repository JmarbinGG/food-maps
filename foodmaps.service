[Unit]
Description=Food Maps API Server
# network-online, not just network.target: the database is remote (RDS), so
# the unit needs routable networking rather than merely a configured stack.
# The former mysql.service ordering was vestigial — there is no local MySQL on
# this host for systemd to wait on. Reconnect resilience comes from
# pool_pre_ping in backend/db.py plus Restart=always below.
After=network-online.target
Wants=network-online.target

# Bound restart attempts to avoid a thundering-herd or CPU spin when the
# process dies immediately on boot, for example on a config error. Allow up to
# 5 restarts per 60s before giving up.
#
# These belong in [Unit]. systemd moved them out of [Service] in v229, and
# left there they are parsed as unknown directives and silently ignored, which
# means the rate limit was never actually in force.
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=ec2-user
Group=ec2-user
WorkingDirectory=/home/ec2-user/project/backend

# Environment
Environment="PATH=/home/ec2-user/.local/bin:/home/ec2-user/project/backend/venv/bin:/usr/local/bin:/usr/bin:/bin"
Environment="PYTHONPATH=/home/ec2-user/project"
EnvironmentFile=/home/ec2-user/project/.env

# Start script
ExecStart=/bin/bash /home/ec2-user/project/backend/start_server.sh

# Auto-restart configuration. The rate limit that bounds these lives in
# [Unit] above.
Restart=always
RestartSec=10

# Resource limits
LimitNOFILE=65536
TimeoutStopSec=30

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=foodmaps

[Install]
WantedBy=multi-user.target
