# Store text with LF in the repo regardless of the developer's OS.
* text=auto

# Shell scripts run on Linux (EC2, Docker); a CRLF checkout breaks them.
*.sh text eol=lf

# Built bundle: keep byte-identical to what npm run build produced.
frontend/assets/nouri/* -diff

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
