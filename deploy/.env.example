# Copy to deploy/.env on the target host. Compose reads it automatically.
#
# This file holds only non-secret deployment topology. Every actual credential
# (DATABASE_URL, JWT_SECRET, OPENAI_API_KEY, Twilio, EMAIL_PASSWORD) lives in
# AWS Secrets Manager and is fetched at startup by backend/aws_secrets.py.
# Nothing secret should ever be added here.

# ---------------------------------------------------------------------------
# Image
# ---------------------------------------------------------------------------
# Pin to an immutable tag so a rollback is a tag change rather than a rebuild.
# Build with: docker compose -f docker-compose.prod.yml build
FOODMAPS_IMAGE=foodmaps-api:2026-08-23-de38f5e

# ---------------------------------------------------------------------------
# Routing
# ---------------------------------------------------------------------------
FOODMAPS_DOMAIN=staging.foodmaps.example.com

# Which nginx topology to render. Confirm the production answer by running
# deploy/scripts/discover-prod.sh on the existing box before choosing.
#   ./nginx/foodmaps-tls.conf.template        TLS terminates on this instance
#   ./nginx/foodmaps-behind-lb.conf.template  an ALB or CloudFront terminates it
#   ./nginx/foodmaps-staging.conf.template    TLS plus noindex and basic auth
NGINX_CONF=./nginx/foodmaps-staging.conf.template

# Only read by the behind-a-load-balancer config. Must be the load balancer's
# subnet CIDR. A range wider than the proxies you control means clients can
# forge X-Forwarded-For and defeat every IP-keyed rate limit in the app.
FOODMAPS_TRUSTED_PROXY_CIDR=10.0.0.0/16

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
# Which Secrets Manager secret to load. The instance role must be scoped to
# this one ARN; a staging box that can read prod/env is not a staging box.
AWS_SECRET_NAME=staging/env
AWS_REGION=us-west-1

# Used to build password reset and email verification links. If this still
# says production while staging runs against a restored snapshot, staging
# emails send real users working links into production.
PUBLIC_BASE_URL=https://staging.foodmaps.example.com

# Set in docker-compose.prod.yml. "*" is safe only while the api service
# publishes no ports, making nginx its only reachable peer.
FORWARDED_ALLOW_IPS=*

# ---------------------------------------------------------------------------
# Certificates, only when TLS terminates on this box
# ---------------------------------------------------------------------------
CERTBOT_EMAIL=ops@example.com
CERTBOT_DOMAIN=staging.foodmaps.example.com
