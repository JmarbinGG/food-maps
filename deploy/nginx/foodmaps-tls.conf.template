# Topology A: TLS terminates here, on the box, with a Let's Encrypt certificate.
# Use this when nothing sits in front of the instance.
#
# Mounted to /etc/nginx/templates/default.conf.template. The nginx image runs
# envsubst over it at container start, restricted by NGINX_ENVSUBST_FILTER to
# names beginning with FOODMAPS_ so that nginx's own $host, $scheme and
# $remote_addr survive untouched.

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80;
    listen [::]:80;
    server_name ${FOODMAPS_DOMAIN};
    # FOODMAPS_DOMAIN may be a space-separated list, e.g.
    # "dogoodfoodmaps.com www.dogoodfoodmaps.com foodmaps.allgoodlivingfoundation.org"
    # -- nginx's server_name directive takes multiple names natively, and
    # envsubst just drops the raw string in here. FOODMAPS_CERT_NAME below is
    # the single certbot lineage name that actually holds the files (the
    # lineage's directory is named after whichever domain was primary when
    # the cert was issued, not the full SAN list).

    # Must stay reachable over plain HTTP for certificate renewal.
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ${FOODMAPS_DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${FOODMAPS_CERT_NAME}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${FOODMAPS_CERT_NAME}/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_stapling        on;
    ssl_stapling_verify on;

    include /etc/nginx/snippets/security-headers.conf;
    # Safe here because this block owns the TLS decision. Do not copy it into
    # the behind-a-load-balancer config, where plain HTTP may be intentional.
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    # Coarse outer bound only. app.py enforces the real limits per route:
    # 64KB for most of /api, 26MB for voice, 9MB for image upload.
    client_max_body_size 1m;

    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/plain text/css application/json application/javascript
               application/x-javascript text/xml application/xml image/svg+xml;

    access_log /var/log/nginx/foodmaps.access.log;
    error_log  /var/log/nginx/foodmaps.error.log warn;

    # The multipart upload routes. Kept as its own block purely to raise the
    # body limit; everything else about it matches location /.
    location /api/ai/ {
        client_max_body_size 32m;
        include /etc/nginx/snippets/proxy-app.conf;
    }

    # Uploaded photos. Long-lived because filenames are content-addressed on
    # write, so a changed photo is a changed URL.
    location /uploads/ {
        expires 30d;
        # Both re-included deliberately: nginx discards every add_header
        # inherited from the server block as soon as a location declares one of
        # its own, so omitting these would silently strip nosniff and HSTS from
        # exactly the responses that serve user-supplied files.
        include /etc/nginx/snippets/security-headers.conf;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        add_header Cache-Control "public, immutable";
        include /etc/nginx/snippets/proxy-app.conf;
    }

    # Load balancer and uptime probes. Note the path is /health; /api/health
    # exists only in backend/dev_app.py and 404s in production.
    location = /health {
        access_log off;
        include /etc/nginx/snippets/proxy-app.conf;
    }

    # Everything else: API routes, then the frontend, which FastAPI serves
    # itself from a StaticFiles mount at "/". There is no separate document
    # root for nginx to serve from.
    location / {
        include /etc/nginx/snippets/proxy-app.conf;
    }
}
