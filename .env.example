# ============================================================================
# FoodMaps environment template — copy to .env and fill in real values.
# DO NOT commit .env (it is in .gitignore).
# ============================================================================

# ---- Database (MySQL on AWS RDS) ----
# Local development: set DATABASE_URL here.
# Production: omit DATABASE_URL from this file and put it in Secrets Manager
# (AWS_SECRET_NAME). systemd EnvironmentFile is loaded first; if DATABASE_URL
# stays here, rotating the secret has no effect. This is not SSM Parameter
# Store — backend/aws_secrets.py reads Secrets Manager only.
DATABASE_URL=mysql+pymysql://USER:PASSWORD@HOST:3306/DBNAME
# USE_RDS=1 skips .env.local SQLite overrides (needed when you want real RDS locally).
# USE_RDS=
# ALLOW_SQLITE=true is required only for in-memory/local SQLite tests. Production
# refuses sqlite:// unless this is set.
# ALLOW_SQLITE=

# ---- AWS Secrets Manager (production / staging) ----
# AWS_SECRET_NAME=prod/env
# AWS_REGION=us-west-1

# ---- App / auth ----
JWT_SECRET=change-me-to-a-long-random-string
# Admin bootstrap endpoints (/api/admin/make-admin, /api/admin/delete-user).
# Leave unset to disable those routes.
# ADMIN_SECRET=
# Public site origin for links in emails / AI messages (no trailing slash)
PUBLIC_BASE_URL=http://localhost:8000
# Uvicorn trusted proxies (production compose defaults to * behind unpublished API)
# FORWARDED_ALLOW_IPS=*
# Other sites allowed to call the API from a browser (comma-separated).
# Default: dogoodfoodmaps.com, www.dogoodfoodmaps.com, localhost:8000 and
# PUBLIC_BASE_URL. The site itself is same-origin and needs no entry.
# CORS_ORIGINS=https://dogoodfoodmaps.com,https://www.dogoodfoodmaps.com
# Serve /docs, /redoc and /openapi.json (off by default; dev only).
# ENABLE_API_DOCS=1

# ---- Mapbox (maps + geocoding) ----
MAPBOX_TOKEN=pk.your_mapbox_public_token

# ---- Twilio (SMS) ----
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER="+15555555555"

# ---- Email (password reset / verification) ----
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# EMAIL_USERNAME=noreply.foodmaps@gmail.com
# EMAIL_PASSWORD=

# ---- OpenAI (AI assistant) ----
# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-REPLACE_WITH_YOUR_KEY

# ---- AI configuration ----
# Chat / follow-up models (defaults match backend/ai/ai_engine.py)
AI_CHAT_MODEL=gpt-4.1
AI_FOLLOWUP_MODEL=gpt-4.1-mini
# Tried in order when the account can't use the model above (404/model_not_found).
# AI_CHAT_MODEL_FALLBACKS=gpt-4o,gpt-4o-mini
# AI_FOLLOWUP_MODEL_FALLBACKS=gpt-4o-mini
# Max tool-calling rounds per chat turn.
# AI_MAX_TOOL_ROUNDS=8
# Whisper STT + OpenAI TTS (optional overrides)
# AI_WHISPER_MODEL=whisper-1
# AI_TTS_MODEL=tts-1
# AI_TTS_VOICE=nova
# AI_TTS_VOICE_ES=nova
# Require Bearer JWT on user-scoped /api/ai/* routes (default: true)
AI_REQUIRE_AUTH=true
# AI_MAX_RETRIES=2
# AI_TIMEOUT=30
# Requests per IP per minute: signed-in AI routes, and the anonymous landing-page chat.
# AI_RATE_LIMIT=50
# AI_PUBLIC_RATE_LIMIT=15
REMINDER_CHECK_INTERVAL=900

# ---- New-listing SMS broadcasts (drafted for admin approval) ----
# AI_BROADCAST_INTERVAL=3600        # seconds between scans
# AI_BROADCAST_LOOKBACK_MIN=75      # minimum window per scan
# AI_BROADCAST_CATCHUP_HOURS=24     # window for the first scan after a restart
# AI_BROADCAST_MAX_PER_RUN=500
# AI_BROADCAST_AUTO_APPROVE=0       # 1 sends drafts without an admin click

# ---- Local development only ----
# Password for the seeded *.smoke@example.com accounts. They are created only
# when DATABASE_URL is SQLite AND ALLOW_SQLITE=true AND AWS_SECRET_NAME is unset.
# LOCAL_DEV_PASSWORD=password123
