# ============================================================================
# FoodMaps environment template — copy to .env and fill in real values.
# DO NOT commit .env (it is in .gitignore).
# ============================================================================

# ---- Database (MySQL on AWS RDS) ----
# Local development: set DATABASE_URL here.
# Production: omit DATABASE_URL from this file and put it in Secrets Manager
# (AWS_SECRET_NAME). systemd EnvironmentFile is loaded first; if DATABASE_URL
# stays here, rotating the secret has no effect. This is not SSM Parameter
# Store — backend/aws_secrets.py reads Secrets Manager only.
DATABASE_URL=mysql+pymysql://USER:PASSWORD@HOST:3306/DBNAME
# USE_RDS=1 skips .env.local SQLite overrides (needed when you want real RDS locally).
# USE_RDS=
# ALLOW_SQLITE=true is required only for in-memory/local SQLite tests. Production
# refuses sqlite:// unless this is set.
# ALLOW_SQLITE=

# ---- AWS Secrets Manager (production / staging) ----
# AWS_SECRET_NAME=prod/env
# AWS_REGION=us-west-1

# ---- App / auth ----
JWT_SECRET=change-me-to-a-long-random-string
# Admin bootstrap endpoints (/api/admin/make-admin, /api/admin/delete-user).
# Leave unset to disable those routes.
# ADMIN_SECRET=
# Public site origin for links in emails / AI messages (no trailing slash)
PUBLIC_BASE_URL=http://localhost:8000
# Uvicorn trusted proxies (production compose defaults to * behind unpublished API)
# FORWARDED_ALLOW_IPS=*

# ---- Mapbox (maps + geocoding) ----
MAPBOX_TOKEN=pk.your_mapbox_public_token

# ---- Twilio (SMS) ----
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER="+15555555555"

# ---- Email (password reset / verification) ----
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# EMAIL_USERNAME=noreply.foodmaps@gmail.com
# EMAIL_PASSWORD=

# ---- OpenAI (AI assistant) ----
# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-REPLACE_WITH_YOUR_KEY

# ---- AI configuration ----
# Chat / follow-up models (defaults match backend/ai/ai_engine.py)
AI_CHAT_MODEL=gpt-4.1
AI_FOLLOWUP_MODEL=gpt-4.1-mini
# Whisper STT + OpenAI TTS (optional overrides)
# AI_WHISPER_MODEL=whisper-1
# AI_TTS_MODEL=tts-1
# AI_TTS_VOICE=nova
# AI_TTS_VOICE_ES=nova
# Require Bearer JWT on user-scoped /api/ai/* routes (default: true)
AI_REQUIRE_AUTH=true
# AI_MAX_RETRIES=2
# AI_TIMEOUT=30
# AI_RATE_LIMIT=50
REMINDER_CHECK_INTERVAL=900
